{"version":1,"content":"<html>\n<body><p>\n\t\t\t加拿大溫哥華舉辦，模仿英偉達前行政總裁黃仁勳比賽，參賽者都穿上一身皮褸，滿頭白髮及戴上眼鏡，亦有女性參觀。比賽中也有人模仿黃仁勳的婚外情對象。<br/>\n<br/>\n<br/>\n編輯：詹可揚\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-23T12:13:57.667366+00:00","quality":{"score":0,"chars":78,"images":0,"source":"RTHK 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-23T11:46:53+00:00","fetched_at":"2026-11-23T15:09:50.210031+00:00","content_updated_at":"2026-11-23T12:07:27.801572+00:00","content_hash":"a14fd058ba909d9a52b8c704f227d48b90682c339784443a35b7a2c32d343915","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}