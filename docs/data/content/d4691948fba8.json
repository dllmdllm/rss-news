轉載。】</p></body></html>","scraped_at":"2026-10-28T05:41:45.325696+00:00","quality":{"score":3,"chars":1934,"images":14,"source":"HK01 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-28T05:30:54+00:00","fetched_at":"2026-10-28T07:18:41.264598+00:00","content_updated_at":"2026-10-28T05:38:33.888545+00:00","content_hash":"51a0896ece0a5dc3301618db9cc7b4efbf79c811e455b6a6e5ac12a31409ee10","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}