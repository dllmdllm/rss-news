{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，旅遊界17名當選人分別是沈朝生、董沛銓、馬煜文、王美嬌、施俊明、譚光舜、李振庭、鄧雯蕙、林浩輝、黃焯安、蘇子楊、黃子榮、吳熹安、黃進達、彭彧、林心亷、劉海天。 <br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:43:50.664900+00:00","quality":{"score":0,"chars":104,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T14:27:38+00:00","fetched_at":"2026-11-22T19:37:47.830948+00:00","content_updated_at":"2026-11-22T14:37:26.986884+00:00","content_hash":"81c72483f56a6576e4196fe17946028081dd7e665f09ba93aaf70ee722116bb7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}