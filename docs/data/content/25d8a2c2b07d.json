17.5度，是入秋以來的最低紀錄，市民上班時都身穿保暖衣物。（湯致遠攝）</figcaption></figure></body></html>","scraped_at":"2026-11-10T22:28:08.919524+00:00","quality":{"score":3,"chars":2301,"images":22,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-10T22:13:23+00:00","fetched_at":"2026-11-11T02:04:09.906792+00:00","content_updated_at":"2026-11-10T22:21:42.090823+00:00","content_hash":"67cedffd7f906d7a7d7636b31b8da0d1b77f64f506ff6732239b771fa60a7d59","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}