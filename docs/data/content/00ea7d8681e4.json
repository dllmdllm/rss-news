{"version":1,"content":"<html>\n<body><p>\n\t\t\t一名日前在屯門失蹤的77歲男子已被尋回。他沒有受傷，案件沒有可疑。<br/>\n<br/>\n該名男子前日在青楊街最後露面後失蹤，家人同日報案。他今日上午在天水圍青山公路–洪水橋段被尋回。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-18T02:24:22.433453+00:00","quality":{"score":0,"chars":88,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-18T02:04:14+00:00","fetched_at":"2026-11-18T03:38:35.040923+00:00","content_updated_at":"2026-11-18T02:17:31.862686+00:00","content_hash":"9368ad42f890be1d53368ded901f0bf3c0309a6c5b29b506851279047b7560c4","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}