24T09:44:00.603008+00:00","quality":{"score":3,"chars":2164,"images":26,"source":"HK01 熱話","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-24T09:30:33+00:00","fetched_at":"2026-11-24T10:17:21.696409+00:00","content_updated_at":"2026-11-24T09:37:24.061691+00:00","content_hash":"2d85f12ccd2698205a811065cac30777b33047728e54a6baaf1f65e02c15d4d0","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}