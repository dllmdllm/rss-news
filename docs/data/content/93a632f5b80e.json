{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，商界（第二）17名當選人分別是陳幼南、王紹基、方添輝、王淑慈、楊華勇、莊學山、謝湧海、陳斌、李德剛、楊振鑫、楊燕芝、伍淑清、邱建新、黃楚恒、王彭彥、葉少明、高敏堅。<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:23:48.370854+00:00","quality":{"score":0,"chars":107,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T13:40:20+00:00","fetched_at":"2026-11-22T14:57:27.043831+00:00","content_updated_at":"2026-11-22T14:17:23.507051+00:00","content_hash":"943e582e9419884fca9e950326b5ed338cd566bfd639bf72827ff5c8d66404c7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}