rc=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e97bab6b2cc8e84cd3540baf4437da29/2026-05/WhatsApp_Image_2026-05-15_at_10_32_45_AM_4_.jpeg\"/>\n<img alt=\"谷薇麗親友神情肅穆。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/9a2faa1abe05cc098ccccfde9f7632d3/2026-05/WhatsApp_Image_2026-05-15_at_10_32_45_AM_5_.jpeg\"/>\n<img alt=\"穿着黑衣到場。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/a36ba86acbfad014df9269c18557e491/2026-05/WhatsApp_Image_2026-05-15_at_10_32_45_AM.jpeg\"/>\n<img alt=\"谷薇麗親友致送花牌。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/090d90197b483700202b9e821360aa8d/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_1_.jpeg\"/>\n<img alt=\"谷薇麗離世親友大早到場送別。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/3a470e014b64dc96444acbf75d9a32f9/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_2_.jpeg\"/>\n<img alt=\"神情哀傷。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/7190e402f4b98e0110c7433f33063791/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_3_.jpeg\"/>\n<img alt=\"谷薇麗離世親友送別。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/56330d47e538c0a1c4c9c656bd7dcad4/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_4_.jpeg\"/>\n<img alt=\"梁君彥。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/1e70f37fbd7c7e97dfd4e555522de87e/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_5_.jpeg\"/>\n<img alt=\"谷薇麗親友陸續到場。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/30300bfe5b008c6b343760e6b223ce6c/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM_6_.jpeg\"/>\n<img alt=\"神情悲傷。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/8868ee459d9f5cb1571c37a27a00adc8/2026-05/WhatsApp_Image_2026-05-15_at_10_32_46_AM.jpeg\"/>\n<img alt=\"谷薇麗丈夫林炯熾和親友擁抱。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/1bf1fdfacaec0d645d986fd5a9811185/2026-05/WhatsApp_Image_2026-05-15_at_10_32_47_AM_1_.jpeg\"/>\n<img alt=\"陳果。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/132ec024791303bcf3656838586226d4/2026-05/WhatsApp_Image_2026-05-15_at_10_32_47_AM_2_.jpeg\"/>\n<img alt=\"劉德華致送花牌。\"