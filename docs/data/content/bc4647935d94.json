{"version":1,"content":"<html>\n<body><p>\n\t\t\t伊朗發生巴士翻側意外，造成12人死亡。<br/>\n<br/>\n伊朗傳媒報道，意外昨日在伊拉姆省發生，引述當地司法部門說，涉事巴士當時載有一間石油天然氣公司員工。<br/>\n<br/>\n省長表示，伊朗總統和內政部長已下令調查事故原因，並要求調配資源救治傷者。<br/>\n<br/>\n<br/>\n<br/>\n編輯：方潤南\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-15T11:20:01.195775+00:00","quality":{"score":0,"chars":113,"images":0,"source":"RTHK 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-15T10:45:45+00:00","fetched_at":"2026-11-15T13:15:10.787439+00:00","content_updated_at":"2026-11-15T11:13:42.304375+00:00","content_hash":"f527cca0573011e319ab01c2e4fc1eeddf5a02195eb699462a0013b8eb0402e0","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}