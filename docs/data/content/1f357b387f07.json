.809526+00:00","quality":{"score":3,"chars":2382,"images":20,"source":"HK01 中國","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-21T04:30:28+00:00","fetched_at":"2026-11-21T23:33:51.350734+00:00","content_updated_at":"2026-11-21T17:28:17.759530+00:00","content_hash":"771a26b958114bb74a9be96bfbd58fe88e2079d42b7377c4b714f9b361c7af01","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}