{"version":1,"content":"<html>\n<body><p>\n\t\t\t粉嶺坪輋路一個貨倉晚上8時許發生火警，消防至近10時將火救熄，消防人員正進行降溫及散煙行動。<br/>\n<br/>\n消防表示，如市民受到隨風飄散的煙霧和異味影響，請關閉門窗及保持鎮定。 <br/>\n<br/>\n<br/>\n<br/>\n編輯：任順熙\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-13T15:23:35.540311+00:00","quality":{"score":0,"chars":88,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-13T14:57:46+00:00","fetched_at":"2026-11-13T22:42:34.804405+00:00","content_updated_at":"2026-11-13T15:16:58.697881+00:00","content_hash":"7712e064583ba63115fdb650a9b1da68a3b8170697c308aafac9c984db593371","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}