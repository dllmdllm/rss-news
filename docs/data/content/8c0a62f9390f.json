{"version":1,"content":"<html>\n<body>\n<div class=\"isolate\" id=\"__nuxt\">\n<div>\n<div class=\"newsInnerPage_container\">\n<div class=\"module_wrapper\">\n<div class=\"module_left\">\n<div class=\"article-section section section_1\" id=\"article-1179192\">\n<div class=\"sec_head\">\n</div>\n<div class=\"sec_cont\">\n<div class=\"text_box\">\n<div>\n<p style=\"text-align: left;\">恒生指數收市報22,671點，跌405點。</p>\n<p style=\"text-align: left;\">舜宇光學跌百分之9.1，極兔速遞升4.5%。</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</body>\n</html>","scraped_at":"2026-06-26T08:36:06.547833+00:00","quality":{"score":0,"chars":44,"images":0,"source":"TVB 新聞","fallback":"unknown"}}