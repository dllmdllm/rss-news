":21,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-17T22:22:20+00:00","fetched_at":"2026-11-17T23:56:18.284207+00:00","content_updated_at":"2026-11-17T22:46:52.338860+00:00","content_hash":"90123a42329550b3707d50865ea189ce7a1c3594de503981ea55740ad5d62281","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}