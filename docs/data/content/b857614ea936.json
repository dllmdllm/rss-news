y></html>","scraped_at":"2026-11-10T12:40:35.798094+00:00","quality":{"score":3,"chars":1447,"images":20,"source":"HK01 熱話","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-10T12:30:43+00:00","fetched_at":"2026-11-10T20:30:49.675587+00:00","content_updated_at":"2026-11-10T12:34:12.592098+00:00","content_hash":"063b2e288f4a165ba339970e8525c1fbbf0eadc0a396a63081e858396667e93c","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}