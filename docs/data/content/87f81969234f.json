{"version":1,"content":"<html>\n<body><p>\n\t\t\t葵涌安捷街一間學校，早上10時許進行工程期間，有5名學生被石屎弄傷，其中兩人眼部受傷，送往瑪嘉烈醫院治理。<br/>\n<br/>\n警方將案件列作有人意外受傷處理。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-21T09:03:52.721668+00:00","quality":{"score":0,"chars":77,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-21T08:50:29+00:00","fetched_at":"2026-11-21T11:37:28.329119+00:00","content_updated_at":"2026-11-21T08:57:24.981423+00:00","content_hash":"e6f551d3feb46513f70976071e6eebcd79113cea5d5cba6e0e23008c031ad6c5","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}