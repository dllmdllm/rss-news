0x0/100/none/b6c1387acc4f854fdf992518f5ac6daf/2023-09/CM010.jpg\"/>\n<img alt=\"外面還有私家泳池。\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/c8318bd3d8971ed8e2f7ac5b7b9d872d/2023-09/CM028.jpg\"/>\n</body>\n</html>","scraped_at":"2026-10-05T09:38:49.516152+00:00","quality":{"score":2,"chars":705,"images":73,"source":"星島頭條","fallback":"none"}}