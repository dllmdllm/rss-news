{"version":1,"content":"<html>\n<body><p>\n\t\t\t沙田路近博康商場早上7時許發生交通意外，涉及兩輛私家車。<br/>\n<br/>\n運輸署表示，受意外影響，沙田路往馬鞍山方向近新田圍全線封閉，獅子山隧道往沙田方向實施間歇性封閉。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-26T01:18:06.365849+00:00","quality":{"score":0,"chars":84,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-26T00:18:11+00:00","fetched_at":"2026-11-26T04:54:31.834116+00:00","content_updated_at":"2026-11-26T01:11:40.140932+00:00","content_hash":"c320f8382da551c0c53cb0a05f451dad50d8746429403bf2eec5a3e33a3dd081","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}