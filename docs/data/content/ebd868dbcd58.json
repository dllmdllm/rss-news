{"version":1,"content":"<html>\n<body><p>\n\t\t\t沙田路近博康商場早上7時許發生交通意外，涉及兩架私家車。<br/>\n<br/>\n運輸署表示，受意外影響，沙田路往馬鞍山方向近新田圍全線封閉，獅子山隧道往沙田方向實施間歇性封閉。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-26T00:37:35.739496+00:00","quality":{"score":0,"chars":84,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-26T00:18:11+00:00","fetched_at":"2026-11-26T00:51:25.995645+00:00","content_updated_at":"2026-11-26T00:31:13.067219+00:00","content_hash":"e8f43d2c63ad5fe60613960242fa2be12275c459d5ee10be59adfcb0e3e7a52a","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}