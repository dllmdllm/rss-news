l","completeness":"extracted"},"published_at":"2026-11-16T06:15:01+00:00","fetched_at":"2026-11-16T07:07:37.391153+00:00","content_updated_at":"2026-11-16T06:27:05.092446+00:00","content_hash":"6d902d30a01f440cead2e397ed206bf27f027c999a323244deb991b301343915","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}