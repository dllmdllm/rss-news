","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-17T01:30:38+00:00","fetched_at":"2026-11-17T02:20:18.775800+00:00","content_updated_at":"2026-11-17T01:39:44.155814+00:00","content_hash":"70125c78237dbfd76aae35076d5b6aba8879ad519fdc69da2da38616c737674f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}