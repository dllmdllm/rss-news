cXGZmwL1_k5C8q_ivfKv4r0\"/><figcaption>李悅彤2015年的模樣。（VCG）</figcaption></figure></body></html>","scraped_at":"2026-11-10T14:22:03.350402+00:00","quality":{"score":3,"chars":2318,"images":44,"source":"HK01 娛樂","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-10T14:00:21+00:00","fetched_at":"2026-11-10T15:16:01.283863+00:00","content_updated_at":"2026-11-10T14:15:33.115664+00:00","content_hash":"2ec3a16895b746d159f3c5fe89a2061d51a226c915d017de4305bc23c080c98c","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}