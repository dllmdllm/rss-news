{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，中醫界15名當選人分別是朱恩、莫飛智、陳漢忠、楊卓明、林國强、曾超慶、盧鼎儒、何國偉、黃傑、張煒生、張群湘、彭祥喜、彭志標、呂愛平、李穎欣。<br/>\n<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:23:52.165800+00:00","quality":{"score":0,"chars":95,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T12:59:25+00:00","fetched_at":"2026-11-22T13:57:29.661360+00:00","content_updated_at":"2026-11-22T13:17:26.811690+00:00","content_hash":"c95952ce9df87b04748be946211793d525ccd853abeeb7dd59430df034d1640b","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}