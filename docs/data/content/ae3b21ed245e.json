{"version":1,"content":"<html>\n<body><p>\n\t\t\t韓國三星電子前副社長、世宗研究所客座研究委員李秉澈認為，韓中兩國合作，已由過往的「垂直分工」，逐步轉變成「水平合作」的模式，他相信兩國間競爭無法避免，但同時合作空間也隨之擴大。<br/>\n<br/>\n<br/>\n<br/>\n編輯：劉景輝\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-19T12:16:55.802027+00:00","quality":{"score":0,"chars":95,"images":0,"source":"RTHK 大中華","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-19T11:53:35+00:00","fetched_at":"2026-11-20T09:09:59.941469+00:00","content_updated_at":"2026-11-19T12:10:19.970392+00:00","content_hash":"924dad0f4395db83b41a5c4f3b0f83b3b1dd1eb914fe3c680e5ce5e1fedb52af","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}