{"version":1,"content":"<html>\n<body><p>\n\t\t\t尖沙咀下午發生交通意外，初步有4人受傷，包括一名傷者昏迷。<br/>\n<br/>\n現場是寶勒巷6號對開，下午近2時半，警方接報指，一輛私家車懷疑剷上行人路，初步有4人受傷。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T07:23:53.195176+00:00","quality":{"score":0,"chars":82,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T06:56:03+00:00","fetched_at":"2026-11-22T09:57:28.682405+00:00","content_updated_at":"2026-11-22T07:17:26.490122+00:00","content_hash":"96acdae83d02f31e3b36564538d8ed6c34d32f423f2e8b47e2489fd660fad5a7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}