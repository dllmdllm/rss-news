{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，會計界15名當選人分別是盧華基、湯飈、林冠良、許麗瓊、梁光健、葉毅成、任德煇、施連燈、鄧海蓮、陳美寳、范秉維、黃慧琪、廖於勤、甘志成、陳錦榮。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:03:52.470136+00:00","quality":{"score":0,"chars":96,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T12:44:31+00:00","fetched_at":"2026-11-22T12:57:29.328296+00:00","content_updated_at":"2026-11-22T12:57:29.328296+00:00","content_hash":"7e7d727d7bf02969181e147bbf35e71a6a5e0a071a088794ff1f6d2bd49769ca","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}