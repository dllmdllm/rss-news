」授權轉載。】</p></body></html>","scraped_at":"2026-10-26T06:40:16.194364+00:00","quality":{"score":3,"chars":1824,"images":15,"source":"HK01 熱話","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-26T06:30:19+00:00","fetched_at":"2026-10-26T07:18:26.330254+00:00","content_updated_at":"2026-10-26T06:38:15.865450+00:00","content_hash":"4426c8ce4727b1ffb64f5c66b469010bf65f2dff411e46bf8dd740172052aeae","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}