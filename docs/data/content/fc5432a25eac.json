0/none/ef0ddd048a17a88ce51db6e122d67674/2024-05/68_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/5a606eab76c439403750853bad71efb1/2024-05/69_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/de2d7096d8320b4e5d56c34e67a9bfcf/2024-05/70_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e2b7b1ad2e95e9317a15071047b9124d/2024-05/71_5.png\"/>\n<p>---</p>\n<p></p>\n</body>\n</html>","scraped_at":"2026-11-17T03:27:21.649561+00:00","quality":{"score":2,"chars":1104,"images":63,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-17T03:00:01+00:00","fetched_at":"2026-11-17T05:13:03.101747+00:00","content_updated_at":"2026-11-17T03:20:58.144471+00:00","content_hash":"c32ca93ef73cfb38ec5d88c63792a9eb0f2ffb985174123776d97863f668c378","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}