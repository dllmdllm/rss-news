om/wp-content/uploads/2026/11/20_9370671436afd2cab599b4.jpg\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"跟風旅行團 杜如風 （圖片來源：TVB）\" decoding=\"async\" height=\"484\" loading=\"lazy\" src=\"https://imgs.weekendhk.com/wp-content/uploads/2026/11/20_9370671436afd2cab599b4.jpg\" width=\"960\"/></a><figcaption>（圖片來源：TVB）</figcaption></figure>\n</p>\n<p>\n</p>\n<p></p>\n<p>\n<i></i>\nTags :\n<a href=\"https://www.gotrip.hk/tag/%e8%b7%9f%e9%a2%a8%e6%97%85%e8%a1%8c%e5%9c%98/\" rel=\"noopener noreferrer\" target=\"_blank\">跟風旅行團</a><a href=\"https://www.gotrip.hk/tag/%e6%9d%9c%e5%a6%82%e9%a2%a8/\" rel=\"noopener noreferrer\" target=\"_blank\">杜如風</a><a href=\"https://www.gotrip.hk/tag/g/\" rel=\"noopener noreferrer\" target=\"_blank\">g</a><a href=\"https://www.gotrip.hk/tag/dragon/\" rel=\"noopener noreferrer\" target=\"_blank\">Dragon</a> </p>\n<p>\n<i></i>\n<p>\n圖片來源：TVB資料或影片來源：<a href=\"https://www.weekendhk.com/3545274\" rel=\"noopener noreferrer\" target=\"_blank\">原文刊於新假期</a>\n</p>\n</p><p></p>\n<a href=\"https://www.gotrip.hk/category/%e6%97%85%e9%81%8a%e8%a9%b1%e9%a1%8c/\" rel=\"noopener noreferrer\" target=\"_blank\">旅遊話題</a>\nNov 18 2026\n\n\n\n\n\n\n\n\n\n\n\n\n\n<p></p></body></html>","scraped_at":"2026-11-18T10:24:07.271465+00:00","quality":{"score":2,"chars":1145,"images":8,"source":"GoTrip","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-18T08:30:30+00:00","fetched_at":"2026-11-18T10:17:31.921165+00:00","content_updated_at":"2026-11-18T10:17:31.921165+00:00","content_hash":"eeb0c7cae9b75152f355f1d8d934498bf97369730d2722999c88cc0b2104f5ea","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}