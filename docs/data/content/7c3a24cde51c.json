0260602/1138438040646062080974063.png/1T15GtlFPWVKIymHHFdsqfCS4YwK0__ddOeKIXTniiE\"/><figcaption>店鋪外景。（羊城晚報）</figcaption></figure></body></html>","scraped_at":"2026-06-16T05:57:52.386846+00:00","quality":{"score":3,"chars":1522,"images":19,"source":"HK01 中國","fallback":"none"}}