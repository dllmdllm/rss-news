{"version":1,"content":"<html>\n<body><p>\n\t\t\t一艘由上環開往蛇口的客輪早上約9時半駛至青衣油庫對開時，懷疑撞到船塢設施，船上有25人受傷，其中5人傷勢較嚴重，當中3人送往瑪嘉烈醫院，另外2人送往仁濟醫院。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-27T03:23:55.022276+00:00","quality":{"score":0,"chars":86,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-27T03:07:19+00:00","fetched_at":"2026-11-27T04:41:44.889769+00:00","content_updated_at":"2026-11-27T03:17:29.724561+00:00","content_hash":"53e7dddc398a31d7dadb3ca2484af80d4f54f017bdd3800839e640632b039be2","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}