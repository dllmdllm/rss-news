{"version":1,"content":"<html>\n<body><p>\n\t\t\t一艘由上環開往蛇口的客輪早上約9時半駛至青衣油庫對開時，懷疑撞到船塢設施，船上有20多人受傷，其中5人傷勢較嚴重，當中3人送往瑪嘉烈醫院，另外2人送往仁濟醫院。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-27T05:23:57.618542+00:00","quality":{"score":0,"chars":87,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-27T03:07:19+00:00","fetched_at":"2026-11-27T06:37:31.375394+00:00","content_updated_at":"2026-11-27T05:17:33.381159+00:00","content_hash":"8d363894d5331434abb5f66c9533bc2b4fc38180dc6cc8d6e698938798c10503","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}