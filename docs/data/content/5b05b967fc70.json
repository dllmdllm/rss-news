:"HK01 娛樂","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-22T11:45:33+00:00","fetched_at":"2026-10-22T13:17:48.849484+00:00","content_updated_at":"2026-10-22T11:57:46.485137+00:00","content_hash":"524b9a6cd58f6f2989b551ffaa291d7afec51a3a89dd8bcef2e03e3bb209a662","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}