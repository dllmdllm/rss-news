{"version":1,"content":"<html>\n<body><p>\n\t\t\t香港正式加入「國際人用藥品註冊技術協調會」（ICH），成為監管機構成員。醫務衞生局表示，代表藥物研發和監管水平獲國際認可，加快建設國際醫療創新樞紐。<br/>\n<br/>\n<br/>\n<br/>\n編輯：王濱南\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-20T12:04:06.150727+00:00","quality":{"score":0,"chars":81,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-20T11:46:05+00:00","fetched_at":"2026-11-21T04:37:33.216335+00:00","content_updated_at":"2026-11-20T11:57:22.696011+00:00","content_hash":"d24b3a7dcdf9779aa403b7565ea085caec49718eb579f7901228165b3f894c7d","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}