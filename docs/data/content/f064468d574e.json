{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t亞殘運國家隊於舉重項目奪得今屆賽事首面金牌。<br/>\n<br/>\r\n國家隊代表崔哲於女子41公斤級賽事奪得冠軍，銀牌及銅牌分別由哈薩克及印尼代表奪得。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：李俊傑\t\t</p>\n</body>\n</html>","scraped_at":"2026-10-19T06:19:05.635246+00:00","quality":{"score":0,"chars":71,"images":0,"source":"RTHK 大中華","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-19T05:58:06+00:00","fetched_at":"2026-10-19T10:57:13.747238+00:00","content_updated_at":"2026-10-19T06:17:36.572142+00:00","content_hash":"b10ee8020855d4057e488e19859d72852a2dba049c9c2807198691825c5cdfdf","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}