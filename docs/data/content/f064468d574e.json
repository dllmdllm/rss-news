{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t亞殘運國家隊於舉重項目奪得今屆賽事首面金牌。<br/>\n<br/>\r\n國家隊代表崔哲於女子41公斤級賽事奪得冠軍，銀牌及銅牌分別由哈薩克及印尼代表奪得。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：李俊傑\t\t</p>\n<ul><li>主頁</li></ul></body>\n</html>","scraped_at":"2026-10-19T11:59:14.202882+00:00","quality":{"score":0,"chars":74,"images":0,"source":"RTHK 大中華","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-19T05:58:06+00:00","fetched_at":"2026-10-19T16:38:15.698920+00:00","content_updated_at":"2026-10-19T11:57:55.288060+00:00","content_hash":"b96f788f88cb813a85a2f340ad74084842fe402ad644eda5ee70e0d745e17cb0","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}