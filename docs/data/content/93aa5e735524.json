{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，工業界（第二）17名當選人分別是徐晉暉、吳宏斌、孫榮良、施榮恆、陳家偉、吳國安、史立德、陳永棋、駱百強、黃偉鴻、羅永邦、馬介欽、梁兆賢、黃家和、李世傑、劉健華、吳清煥。<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:43:50.682586+00:00","quality":{"score":0,"chars":109,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T14:11:16+00:00","fetched_at":"2026-11-22T15:57:27.039671+00:00","content_updated_at":"2026-11-22T14:37:27.963273+00:00","content_hash":"6e4457dcd632b69b0a197c3ecb060e8a8d63d36b15d2dabbc745ec0f163601a1","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}