></html>","scraped_at":"2026-10-19T02:39:04.364817+00:00","quality":{"score":3,"chars":1532,"images":18,"source":"HK01 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-19T02:30:21+00:00","fetched_at":"2026-10-19T04:38:22.912205+00:00","content_updated_at":"2026-10-19T02:37:34.517854+00:00","content_hash":"a239b58bd596a8a99eaab5e58da6b9300e7b69c0dccb125f54cc080d8dde57d9","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}