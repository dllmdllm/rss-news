{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，飲食界16名當選人分別陳家強、楊位醒、鄭栢文、鍾偉平、吳德曉、莊裕坤、楊浩宏、梁振華、盛智文、吳子文、楊振年、胡珠、凌偉業、譚家良、盧浩宏、王偉樑。<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:43:50.677251+00:00","quality":{"score":0,"chars":99,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T14:18:34+00:00","fetched_at":"2026-11-22T20:37:44.392925+00:00","content_updated_at":"2026-11-22T14:37:27.742039+00:00","content_hash":"cda3da81b31993820271c2d49ca9775091e600c80b62cab233e4d64bda0dd22c","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}