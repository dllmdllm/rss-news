{"version":1,"content":"<html>\n<body><p>\n\t\t\t馬鞍山耀安邨一名失蹤的少女已被尋回。<br/>\n<br/>\n警方表示，這名14歲少女星期三上午離開其位於耀安邨的住所後失蹤，其家人同日報案。<br/>\n<br/>\n這名少女今日下午在天水圍天瑞邨被尋回。她沒有受傷，案件沒有可疑。<br/>\n<br/>\n<br/>\n<br/>\n編輯：任順熙\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-13T14:43:18.187685+00:00","quality":{"score":0,"chars":99,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-13T14:29:29+00:00","fetched_at":"2026-11-14T04:33:08.069338+00:00","content_updated_at":"2026-11-13T14:36:29.019937+00:00","content_hash":"24861cf9f1d9ca26cec47507728d5dba300421fe67fe28780db4638f8cb5178d","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}