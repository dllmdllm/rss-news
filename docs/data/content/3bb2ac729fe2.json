{"version":1,"content":"<html>\n<body><p>\n\t\t\t發展局局長甯漢豪傍晚前赴廣州，出席翌日舉行的第三屆大灣區文化遺產論壇。<br/>\n　　 <br/>\n甯漢豪將於明日傍晚返港。離港期間，發展局副局長林智文將署任發展局局長。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-24T03:43:56.543953+00:00","quality":{"score":0,"chars":78,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-24T03:28:14+00:00","fetched_at":"2026-11-24T03:57:27.782082+00:00","content_updated_at":"2026-11-24T03:37:28.331905+00:00","content_hash":"2a9fb7efdc4bbb8d4b6225ab391026fb7299d2a010d7c20562bbf5834470da3f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}