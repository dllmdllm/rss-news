></html>","scraped_at":"2026-11-12T10:43:59.024192+00:00","quality":{"score":3,"chars":1544,"images":9,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-12T10:22:30+00:00","fetched_at":"2026-11-12T13:57:32.703492+00:00","content_updated_at":"2026-11-12T10:37:25.727320+00:00","content_hash":"a4c0ab991e33466cd8f1bfca6771c855764c67dc5572aea804816c3d40424ff3","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}