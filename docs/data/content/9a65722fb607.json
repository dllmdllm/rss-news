{"version":1,"content":"<html>\n<body><p>\n\t\t\t沙田路早上發生交通意外，涉及兩輛私家車，其中一名司機現場接受酒精呼氣測試，證實超標，需要帶返警署接受進一步調查。<br/>\n<br/>\n運輸署表示，獅子山隧道往沙田方向取消間歇性封閉。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-26T02:18:55.643732+00:00","quality":{"score":0,"chars":88,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-26T01:48:52+00:00","fetched_at":"2026-11-26T07:56:43.295768+00:00","content_updated_at":"2026-11-26T02:12:19.581685+00:00","content_hash":"4f047ee207e453b71119102a9bb379cba463f3f13768860b9ea72b5790953354","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}