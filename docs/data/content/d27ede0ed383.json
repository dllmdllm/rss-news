{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，地產及建造界17名當選人分別是高志偉、廖聖鵬、龍漢標、郭基泓、陳文博、黃少媚、黃天祥、KERR Keith Graham、侯志超、KESWICK Benjamin William、趙國雄、李家誠、謝偉正、利蘊蓮、羅嘉瑞、張利民、張子仲。<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:43:50.684333+00:00","quality":{"score":0,"chars":143,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T14:09:27+00:00","fetched_at":"2026-11-22T18:17:46.463842+00:00","content_updated_at":"2026-11-22T14:37:27.847005+00:00","content_hash":"69d24240936ef7d704c520aa3be23af22343b29cb7fc7e817aeab4dba01161a7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}