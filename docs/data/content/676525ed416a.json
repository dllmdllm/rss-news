l.hk/f/1024p0/0x0/100/none/19d2517540156e8d7a66b8f539f03db1/2026-11/027_2.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/b4e4aca195ddb5435e228fd550d42f8a/2026-11/028_1.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/3c8040f5efa6c9a32ee09c80addd8370/2026-11/029_0.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e08dc7c08d52e9e51ae6e50a27c3fa41/2026-11/030_1.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/25f471209455fb10c2ecb1f169fea0c6/2026-11/031_1.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/9fd126679ad6d684e054c664065e3db2/2026-11/32_0_4.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/9236353ff307e839392a48eecf22104f/2026-11/33_0_3.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/2eae6f26a56cacf2531e077e4fc6efcc/2026-11/034_0.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/1df5064f8475b080a0d09694714ececf/2026-11/035_0.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/b0a804163f9294b3dbdee2c7b7eb8dff/2026-11/036_0.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/9fa8bd906177a7134df9aeb53d55acec/2026-11/037_0.jpg\"/>\n</body>\n</html>","scraped_at":"2026-11-19T15:39:28.922119+00:00","quality":{"score":3,"chars":1268,"images":67,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-19T11:30:00+00:00","fetched_at":"2026-11-19T19:37:53.750420+00:00","content_updated_at":"2026-11-19T15:33:00.744685+00:00","content_hash":"492be0662d1550e976daa553cb2f3a616cacbe34ade5fbcbd905a5a2e8ff2b58","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}