://cdn.hk01.com/di/media/images/dw/20261126/1202653228249124864861592.jpeg/A81byL9azmJKFqj1Bg3PZ950eYnY_1Nyffa1rGv2taw\"/><figcaption>踏入下午時分陸續有市民，死者家屬及宏福苑居民到場獻花悼念，現場聚集接近逾百人。（王譯揚攝）</figcaption></figure><figure><img alt=\"踏入下午時分陸續有市民，死者家屬及宏福苑居民到場獻花悼念，現場聚集接近逾百人。（王譯揚攝）\" src=\"https://cdn.hk01.com/di/media/images/dw/20261126/1202653230891667456589436.jpeg/XNAUT6VrLsMgDSoweTLnEGc8oSK5VrN571t5HflbeR0\"/><figcaption>踏入下午時分陸續有市民，死者家屬及宏福苑居民到場獻花悼念，現場聚集接近逾百人。（王譯揚攝）</figcaption></figure></body></html>","scraped_at":"2026-11-26T18:24:40.780325+00:00","quality":{"score":3,"chars":1486,"images":21,"source":"HK01 突發","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-26T14:03:01+00:00","fetched_at":"2026-11-26T20:17:48.730908+00:00","content_updated_at":"2026-11-26T18:18:09.384380+00:00","content_hash":"1e00e636541a11d3df86528f79ced9d962542b33271aec89f4703ea5f9c0f051","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}