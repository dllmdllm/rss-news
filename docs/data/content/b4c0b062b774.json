11/179463195396855009_4133784206af7e91300b56.png\" width=\"960\"/></a><figcaption>（圖片來源：TVB）</figcaption></figure>\n<p>\n</p>\n</body></html>","scraped_at":"2026-11-14T06:20:50.524394+00:00","quality":{"score":2,"chars":1077,"images":7,"source":"WeekendHK","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-14T04:56:41+00:00","fetched_at":"2026-11-14T06:14:18.023244+00:00","content_updated_at":"2026-11-14T06:14:18.023244+00:00","content_hash":"9386fa2ddc4e01909cbdeb2dca8d0ef0a9ed7b1cc44692becf93c5950ad4e699","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}