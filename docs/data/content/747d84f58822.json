i/media/images/dw/20261119/1200136990855663616538921.jpeg/DI98ZP41AbfbukLmzQsabP3ySJgf0SH1eXRwWlx0cFo\"/></body></html>","scraped_at":"2026-11-25T22:36:37.366925+00:00","quality":{"score":2,"chars":967,"images":32,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-25T22:09:23+00:00","fetched_at":"2026-11-26T03:53:40.351368+00:00","content_updated_at":"2026-11-25T22:30:05.289739+00:00","content_hash":"9ced8808e5033bd784505ad0c9394d10c2e7ea96952d8a36fe8ef5c0677540c2","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}