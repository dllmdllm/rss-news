ore":3,"chars":1856,"images":26,"source":"HK01 熱話","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-16T11:00:16+00:00","fetched_at":"2026-10-16T22:18:03.395185+00:00","content_updated_at":"2026-10-16T11:17:39.923854+00:00","content_hash":"645a1e60024e15f8029989de7e614ef2986c0362cbad9078bf940262dda148f2","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}