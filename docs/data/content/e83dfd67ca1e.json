e8a/2026-06/26_14.jpg\"/>\n<img alt=\"口腔癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/aa04afb2c7b2e7d0fbc886358805b4ed/2026-06/27_0_4.jpg\"/>\n<img alt=\"藍莓\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/8070219666629f53c82716c388a4d389/2026-06/28_7.jpg\"/>\n<img alt=\"覆盆子\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/047362668a42af9802d1c6cd3e590ce4/2026-06/29_6.jpg\"/>\n<img alt=\"前列腺癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e191adeed321aa97732070848f7992e5/2026-06/30_6.jpg\"/>\n<img alt=\"黑莓\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/5053719bbf51832884cda4df53999ce4/2026-06/31_15.jpg\"/>\n<img alt=\"車厘茄\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/506bfaf8a745dba7ce7880a16d15a39b/2026-06/32_16.jpg\"/>\n<img alt=\"西瓜\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/38252ed6ab5ec6cea19982c9e59e8fbd/2026-06/33_16.jpg\"/>\n<img alt=\"皮膚癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/b6e3e87fe83d2ce62308a8cb79df090d/2026-06/34_13.jpg\"/>\n<img alt=\"士多啤梨\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/bea9a2a216660a87ac028f4d6d9b24f0/2026-06/35_9.jpg\"/>\n<img alt=\"直腸癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e7ef6cb38cd82971ef0201d924ca37c9/2026-06/36_8.jpg\"/>\n<img alt=\"車厘子\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/7f975b6ff9958115edfaea8570dacf0f/2026-06/37_6.jpg\"/>\n<img alt=\"子宮頸癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/590531b1daf097d07a16b87f70df34cc/2026-06/38_3.jpg\"/>\n<img alt=\"檸檬\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/6590fca190928c675428045784349960/2026-06/39_6.jpg\"/>\n<img alt=\"攝護腺癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/971010030443888804236a2af370d148/2026-06/40_7.jpg\"/>\n<img alt=\"木瓜\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/51877d24e072e88eb2354d356c4d3842/2026-06/41_6.jpg\"/>\n<img alt=\"咽喉癌\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/3a7b6256cbd00d72e838ffe5c75d85fd/2026-06/42_7.jpg\"/>\n<img alt=\"洋蔥\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/18dc3cb066fd5ae18bda109bf788c270/2026-06/43_6.jpg\"/>\n<p></p>\n<p></p>\n<p></p>\n</body>\n</html>","scraped_at":"2026-11-25T10:23:54.630991+00:00","quality":{"score":3,"chars":1372,"images":49,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-25T10:00:42+00:00","fetched_at":"2026-11-25T12:17:24.824054+00:00","content_updated_at":"2026-11-25T10:17:19.153373+00:00","content_hash":"c65d40242bc01073bc74848bf67d4157ceea54866a442e42858293ef2f2f84b2","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}