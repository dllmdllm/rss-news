v><p style=\"text-align: left;\"></p><div class=\"image-block responsive-block\" data-bs-component=\"generic\" style=\"margin: 0px 0px 4px; border-radius: 8px; overflow: hidden; background: rgb(255, 255, 255); border: 1px solid rgb(228, 231, 237);\">\n<div class=\"image-container\" style=\"position: relative; width: 100%; border-radius: 8px 8px 0px 0px;\">\n<img alt=\"9b90b87d-62dd-4e7a-919a-ba11b43a1e47.jpg.webp\" src=\"https://tvb-vod-hk.oss-cn-hongkong.aliyuncs.com/uploads/file/2026/08/2026HFQFGCzrBc1786332684.webp\" style=\"width: 100%; max-width: 100%; height: auto; border-radius: 8px 8px 0px 0px; display: block; object-fit: contain;\" title=\"9b90b87d-62dd-4e7a-919a-ba11b43a1e47.jpg.webp\"/>\n</div>\n</div></body></html>","scraped_at":"2026-08-10T13:51:15.490712+00:00","quality":{"score":1,"chars":356,"images":8,"source":"TVB 新聞","fallback":"none"}}