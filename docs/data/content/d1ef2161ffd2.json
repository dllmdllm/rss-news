{"version":1,"content":"<html>\n<body><p>\n\t\t\t港燈宣布，下月燃料調整費向下調，由11月的每度電55.1仙，下調至每度電52.3仙。<br/>\n<br/>\n港燈今年的燃料調整費一度於9月達到全年最高的每度電60.7仙，之後持續下降。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-25T09:23:59.558845+00:00","quality":{"score":0,"chars":88,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-25T09:09:02+00:00","fetched_at":"2026-11-25T22:10:01.315806+00:00","content_updated_at":"2026-11-25T09:17:23.901717+00:00","content_hash":"060d7388d55e1e625ad6d41f43e157528c133b171f080492b7fa9e0d3f55d2d7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}