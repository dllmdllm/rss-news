{"version":1,"content":"<html>\n<body><p>\n\t\t\t葵涌發生工業意外，一名男工人受傷。<br/>\n<br/>\n警方表示，下午5時許接報，貨櫃碼頭有一名年約六旬男工懷疑在駕駛叉車期間，連人帶車由約1.3米高的載貨台墮下，他受傷送往瑪嘉烈醫院治理。<br/>\n<br/>\n<br/>\n編輯：任順熙\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-10T12:20:22.736692+00:00","quality":{"score":0,"chars":92,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-10T11:04:42+00:00","fetched_at":"2026-11-10T16:17:17.269900+00:00","content_updated_at":"2026-11-10T12:13:52.182827+00:00","content_hash":"11517de0c95fa069e42544713115870a08711bc5581163f4d6190851ec066f1f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}