3,"chars":2211,"images":40,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-03T23:30:00+00:00","fetched_at":"2026-11-04T04:19:05.368613+00:00","content_updated_at":"2026-11-03T23:38:36.336856+00:00","content_hash":"23c70272434dbcd0cc360d55853049a03794e23cdccaf9ce09445708c901f5e7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}