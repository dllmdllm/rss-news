{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，社會福利界15名當選人分別是余秀珠、楊建霞、梁惠玲、黃智傑、冼靜儀、李淑慧、陳文浩、李淑霞、黃萬成、趙漢文、李漢祥、陳小麗、崔永康、李玉芝、譚贛蘭。<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:43:45.446655+00:00","quality":{"score":0,"chars":99,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T13:16:51+00:00","fetched_at":"2026-11-22T13:37:22.618180+00:00","content_updated_at":"2026-11-22T13:37:22.618180+00:00","content_hash":"8b83525bbaf668ab3a29763acfe22073bf89fbc2d52f3a0f6e5f847817c52360","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}