rc=\"https://cdn.hk01.com/di/media/images/dw/20261008/1184843855099334656325849.jpeg/xiVkNu4O8o1jB1NAdArIBynAWQxI19x6dkI6OnZCOjo\"/><figcaption>近日，河南鄭州上演了一幕温暖人心的誠信佳話，一的士司機連續三天跑到乘客家裏歸還10萬人民幣現金和手機。（微博@小莉幫忙）</figcaption></figure></body></html>","scraped_at":"2026-11-27T01:43:51.722149+00:00","quality":{"score":3,"chars":1660,"images":18,"source":"HK01 中國","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-27T01:30:42+00:00","fetched_at":"2026-11-27T02:37:30.314456+00:00","content_updated_at":"2026-11-27T01:37:25.963693+00:00","content_hash":"1f0f1d1b1694677578e41c997c8f16b8d2ef44c6e00a2da5a3849ddf8d31ad55","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}