caption></figure></body></html>","scraped_at":"2026-11-23T13:14:59.325834+00:00","quality":{"score":3,"chars":2488,"images":21,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-23T09:24:54+00:00","fetched_at":"2026-11-23T14:49:40.252564+00:00","content_updated_at":"2026-11-23T13:08:23.454851+00:00","content_hash":"ab920bbf75e21b3eb01a5bb1400b7304d8cfcf5e5d2fda41ef23e2a76d3b561a","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}