{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t港隊於亞殘運游泳項目增添一面銀牌。<br/>\n<br/>\r\n港隊泳手吳卓恩於女子S7級50米蝶泳決賽，游出40秒75，奪得亞軍。金牌由日本泳手奪得。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：譚佩貞\t\t</p>\n<ul><li>主頁</li></ul></body>\n</html>","scraped_at":"2026-10-21T10:20:07.582910+00:00","quality":{"score":0,"chars":72,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-21T09:44:09+00:00","fetched_at":"2026-10-21T12:57:49.806551+00:00","content_updated_at":"2026-10-21T10:17:41.776046+00:00","content_hash":"6383af3e02622fb1fb729d5e8e59b6dbcdf9cba87288c7ff51abf853107d52b9","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}