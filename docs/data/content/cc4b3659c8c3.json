{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，進出口界17名當選人分別為王紫雲、嚴玉麟、梁毓雄、李淑媛、張文嘉、趙朗、陳建年、温幸平、王賜豪、許華傑、蔡德昇、趙婉玲、李曠怡、何志豪、陳少山、張壽文、鄧紹坤。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:03:52.468938+00:00","quality":{"score":0,"chars":105,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T12:47:59+00:00","fetched_at":"2026-11-22T13:37:23.591279+00:00","content_updated_at":"2026-11-22T12:57:29.298801+00:00","content_hash":"b64f652ba91faa3cbadbbaedf0e576144555a4ba835e8294602abd116234986d","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}