jny3fw_xmH8P8Zg\"/><img src=\"https://cdn.hk01.com/di/media/images/dw/20260323/1112798331341508608756892.jpeg/mGE_eGn4i_89A2h1-TIStgwRQLpYhoW7JLhMXiS4TF4\"/><img src=\"https://cdn.hk01.com/di/media/images/dw/20260323/1112798328929652736160285.jpeg/Qwp0f4zD7IQWDDGZQ_rB1wSMxsNHrEMmOyDt6zsg7es\"/></body></html>","scraped_at":"2026-10-22T03:02:40.257762+00:00","quality":{"score":3,"chars":2999,"images":31,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-22T02:17:01+00:00","fetched_at":"2026-10-22T02:58:03.316654+00:00","content_updated_at":"2026-10-22T02:58:03.316654+00:00","content_hash":"48f8df8b81ead7773e628c33fe1656f52e78997e2fc01bc8263bdfd643f1a410","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}