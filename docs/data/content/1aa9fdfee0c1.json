01.com/di/media/images/dw/20260213/1099015125886570496793154.jpeg/Fk9GTac2FznfCDaRCuSk1AwbVuRfZEbQw6AcsMOgHLA\"/><figcaption>木村拓哉（Instagram@takuya.kimura_tak）</figcaption></figure><figure><img alt=\"木村拓哉（Instagram@takuya.kimura_tak）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260213/1099015128264871936431798.jpeg/lJXmxHTCPaf3Vn8ZcSQAsBzLMt94yZ1PKNXShyjV0oc\"/><figcaption>木村拓哉（Instagram@takuya.kimura_tak）</figcaption></figure><figure><img alt=\"木村拓哉（Instagram@takuya.kimura_tak）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260213/1099015134791602176173582.jpeg/XoVGpXzEX0LCbWYioPK9nGRExJC4xLMxiT7N1ok-zdY\"/><figcaption>木村拓哉（Instagram@takuya.kimura_tak）</figcaption></figure><figure><img alt=\"木村拓哉（IG@takuya.kimura_tak）\" src=\"https://cdn.hk01.com/di/media/images/dw/20250627/1015237628335099904317490.png/U4BnBS02F5wm-C_Vhea21Zi7HA8ixkmXcL5MXHC-TFw\"/><figcaption>木村拓哉（IG@takuya.kimura_tak）</figcaption></figure><figure><img alt=\"木村拓哉（IG@takuya.kimura_tak）\" src=\"https://cdn.hk01.com/di/media/images/dw/20250627/1015237630621126656253896.png/bn78I9mld9aZPxYxNlT-gD90GEqbAcWqNwPKDjcDyg4\"/><figcaption>木村拓哉（IG@takuya.kimura_tak）</figcaption></figure></body></html>","scraped_at":"2026-11-21T04:23:55.744128+00:00","quality":{"score":3,"chars":4796,"images":72,"source":"HK01 娛樂","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-21T04:01:33+00:00","fetched_at":"2026-11-21T06:37:25.497130+00:00","content_updated_at":"2026-11-21T04:17:21.507338+00:00","content_hash":"9e7a910af1437103bc4706f4859996ae1bdf88943d44b9f6947511f981eaa949","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}