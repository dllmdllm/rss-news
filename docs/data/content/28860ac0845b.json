{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，工業界（第一）17名當選人分別是葉中賢、陳婉珊、陳偉聰、莊子雄、羅名承、劉燊濤、岑健偉、梁君彥、林世豪、周治平、陳耀邦、何柏堅、許文俊、王博文、陳嘉賢、吳慧君、吳民卓。<br/>\n<br/>\n<br/>\n編輯：羅詠暉\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:43:45.456118+00:00","quality":{"score":0,"chars":109,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T13:12:29+00:00","fetched_at":"2026-11-22T14:17:23.622211+00:00","content_updated_at":"2026-11-22T13:37:22.756373+00:00","content_hash":"32cb8266e2cc77399ae0e737fc7772ba1928c07d384a21118032a7274351cb78","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}