30:52+00:00","fetched_at":"2026-10-29T16:38:49.662485+00:00","content_updated_at":"2026-10-29T06:59:18.455266+00:00","content_hash":"cf04331dd7b04fe2e835338f49be3be6c8a161a023ff7285ef7b3dc44f4e98d6","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}