-10-23T03:24:29.009105+00:00","quality":{"score":3,"chars":1869,"images":15,"source":"HK01 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-23T03:00:41+00:00","fetched_at":"2026-10-23T06:39:54.292938+00:00","content_updated_at":"2026-10-23T03:18:17.160250+00:00","content_hash":"fcc6ab0e8a29a6e9df645531db4880e6973eb42ad1012ad78ce891f935219c7a","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}