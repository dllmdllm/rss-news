{"version":1,"content":"<html>\n<body><p>\n\t\t\t強烈季候風信號現正生效，晚間顯著轉涼，氣溫逐步下降至明早市區最低約17度，新界再低一兩度。<br/>\n<br/>\n天文台預測在星期三，日夜溫差頗大，本周後期氣溫回升，周末雲量增多及有幾陣驟雨。\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-09T11:02:20.066239+00:00","quality":{"score":0,"chars":85,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-09T10:43:01+00:00","fetched_at":"2026-11-09T10:56:20.133884+00:00","content_updated_at":"2026-11-09T10:56:20.133884+00:00","content_hash":"7498aff306938fc0076b842c4fee220effe86900fb92eeb650fc0094aebfd9f8","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}