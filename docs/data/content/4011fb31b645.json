{"version":1,"content":"<html>\n<body><p>\n\t\t\t藍田啟田邨發生火警，兩人不適送院。<br/>\n<br/>\n事發在下午1時許，警方接到多人報案指啟旺樓有單位冒煙，消防出動一條喉及一隊煙帽隊灌救，下午約2時將火救熄。初步一男一女吸入濃煙不適。<br/>\n<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-17T07:30:07.872672+00:00","quality":{"score":0,"chars":91,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-17T07:03:30+00:00","fetched_at":"2026-11-17T09:45:24.166282+00:00","content_updated_at":"2026-11-17T07:23:34.280859+00:00","content_hash":"cb4f9cade6b548b03051c33939b2ea97853b2e53786ef7ae43ad474e5b9a8c9a","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}