urce":"HK01 娛樂","fallback":"none"},"published_at":"2026-10-12T12:15:31+00:00","fetched_at":"2026-10-12T13:37:47.135189+00:00","content_updated_at":"2026-10-12T12:37:40.227775+00:00","content_hash":"fad738ff24cc9bde7aef78f626aa8dd3b23cacb4e10e11e353ea7fbdcf624a19","evidence_status":"full","scrape_error":null,"content_retention":null}