把車開上樹」的影片在內地社交平台上瘋傳，調查卻揭露竟是駕駛學院為製造流量而刻意設置的場景。（微博影片截圖）</figcaption></figure></body></html>","scraped_at":"2026-10-30T06:46:21.040578+00:00","quality":{"score":3,"chars":2120,"images":24,"source":"HK01 中國","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-30T06:30:49+00:00","fetched_at":"2026-10-30T06:40:21.700677+00:00","content_updated_at":"2026-10-30T06:40:21.700677+00:00","content_hash":"1ef479b2b8d7450993b7b3b4efdd4376a72e6164b0f3b62e92a4f1368811b937","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}