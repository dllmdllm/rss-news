igcaption></figure><figure><img alt=\"《穀雨》定檔11.05！（微博@電視劇穀雨）\" src=\"https://cdn.hk01.com/di/media/images/dw/20261103/1194300153591631872627459.png/_2DE1rYp1QD8vlIBpOJfL_4DuFDetzDxG4chihuHIYo\"/><figcaption>《穀雨》定檔11.05！（微博@電視劇穀雨）</figcaption></figure><figure><img alt=\"《穀雨》定檔11.05！（微博@電視劇穀雨）\" src=\"https://cdn.hk01.com/di/media/images/dw/20261103/1194300132800073728367280.png/vN3-5VSG6ajHxrU23Sc7PmcfFtlpaU_237YV5t-2FeY\"/><figcaption>《穀雨》定檔11.05！（微博@電視劇穀雨）</figcaption></figure></body></html>","scraped_at":"2026-11-03T12:42:15.484737+00:00","quality":{"score":3,"chars":2072,"images":28,"source":"HK01 娛樂","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-03T12:20:40+00:00","fetched_at":"2026-11-03T12:38:41.799417+00:00","content_updated_at":"2026-11-03T12:38:41.799417+00:00","content_hash":"e10b5c0fb544f6d963140b77d893267baa544b4a19dc8d2615e55313125ffb9b","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}