img alt=\"81968484-d2df-4416-90e6-58bdc093f673.jpeg.webp\" src=\"https://tvb-vod-hk.oss-cn-hongkong.aliyuncs.com/uploads/file/2026/07/2026zoTOM4D1RR1784603956.webp\" style=\"width: 100%; max-width: 100%; height: auto; border-radius: 8px 8px 0px 0px; display: block; object-fit: contain;\" title=\"81968484-d2df-4416-90e6-58bdc093f673.jpeg.webp\"/>\n</div>\n</div><p style=\"text-align: left;\"></p><div class=\"image-block responsive-block\" data-bs-component=\"generic\" style=\"margin: 0px 0px 4px; border-radius: 8px; overflow: hidden; background: rgb(255, 255, 255); border: 1px solid rgb(228, 231, 237);\">\n<div class=\"image-container\" style=\"position: relative; width: 100%; border-radius: 8px 8px 0px 0px;\">\n<img alt=\"69a30824-2cd9-4d84-8690-404b164cd660.jpeg.webp\" src=\"https://tvb-vod-hk.oss-cn-hongkong.aliyuncs.com/uploads/file/2026/07/2026SPZRp6vTU61784603959.webp\" style=\"width: 100%; max-width: 100%; height: auto; border-radius: 8px 8px 0px 0px; display: block; object-fit: contain;\" title=\"69a30824-2cd9-4d84-8690-404b164cd660.jpeg.webp\"/>\n</div>\n</div></body></html>","scraped_at":"2026-07-21T06:18:35.297457+00:00","quality":{"score":1,"chars":208,"images":7,"source":"TVB 新聞","fallback":"none"}}