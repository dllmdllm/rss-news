{"version":1,"content":"<html>\n<body><p>\n\t\t\t運輸署表示，較早前因交通意外而封閉的沙田路往馬鞍山方向、近新田圍的全線現已解封。車龍有待消散。<br/>\n<br/>\n而獅子山隧道往沙田方向仍然實施間歇性封閉。<br/>\n<br/>\n<br/>\n編輯：譚佩貞\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-26T01:58:48.054734+00:00","quality":{"score":0,"chars":76,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-26T01:26:50+00:00","fetched_at":"2026-11-26T05:14:41.545325+00:00","content_updated_at":"2026-11-26T01:52:10.323979+00:00","content_hash":"7dc146258b2ac53c3d5123275ba43fcb703551180fbbdbd791327200d7d5a545","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}