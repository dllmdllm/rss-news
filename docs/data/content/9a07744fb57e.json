{"version":1,"content":"<html>\n<body><p>\n\t\t\t韓聯社報道，韓國京畿道城南市早上發生涉及巴士的連環相撞事故，造成包括巴士司機在內的48人受傷，其中6人重傷、42人輕傷。<br/>\n<br/>\n報道說，事發巴士連續撞了30多部等候交通燈號的車輛。<br/>\n<br/>\n<br/>\n<br/>\n編輯：方潤南\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-11T02:30:55.679022+00:00","quality":{"score":0,"chars":94,"images":0,"source":"RTHK 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-11T01:59:00+00:00","fetched_at":"2026-11-11T09:29:31.747855+00:00","content_updated_at":"2026-11-11T02:24:17.604526+00:00","content_hash":"df4e01939282e6a0803653281a2d18f488ad6c4a2346b4146af16a0513118c4c","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}