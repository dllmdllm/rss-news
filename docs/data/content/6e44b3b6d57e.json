{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t受乾燥的東北季候風影響，廣東天氣晴朗，本港下午天氣炎熱，截至下午1時半，天文台錄得最高氣溫31.2度，是有記錄以來最熱的霜降。<br/>\n<br/>\r\n天文台預測，周末期間天晴及非常乾燥，日夜溫差頗大。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：許敬軒\t\t</p>\n</body>\n</html>","scraped_at":"2026-10-23T06:45:21.958423+00:00","quality":{"score":0,"chars":96,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-23T06:17:54+00:00","fetched_at":"2026-10-23T10:38:30.561503+00:00","content_updated_at":"2026-10-23T06:39:40.187363+00:00","content_hash":"bf63964de6e819a60dc480961754d3c1d7eaceea18823b880402efdf8824a3e7","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}