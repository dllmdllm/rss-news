{"version":1,"content":"<html>\n<body><p>\n\t\t\t美國紐約布魯克林區一棟有90多年歷史的三層高建築物倒塌，最少兩人死亡，十多人受傷。當局正調查事故原因，又透露事發時倒塌建築物旁的地盤正進行挖掘工程。<br/>\n<br/>\n<br/>\n編輯：詹可揚\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-12T12:03:51.884578+00:00","quality":{"score":0,"chars":81,"images":0,"source":"RTHK 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-12T11:37:27+00:00","fetched_at":"2026-11-12T18:17:56.635131+00:00","content_updated_at":"2026-11-12T11:57:24.904159+00:00","content_hash":"2c73e03bed4bc6d68a9f98c2d653cf7429943e9e15a273d52a3992f767e4ad23","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}