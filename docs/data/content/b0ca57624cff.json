></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606955939893248517309.jpeg/_qydtnUNCYt-88_IZLsyxx82TE8D0ue-LRY8RS0WPEU\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606953486094336342719.jpeg/qUzVUWW70TkvtyUbrziy5_abTQmsGMd9iEhJv4hISb8\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606953741946880984561.jpeg/p7u-0QSq1-N3cPbVZmIkpMuLcgtweXRh0NfUQtDX1EI\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606955939893248381250.jpeg/BRvel2FxbWi8r0bgboV_GeM1GwpzmyHCJg3w2CYN8Ng\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606950977769472863719.jpeg/vY0B4mOn0JWQRaj7EYtTOJu87kqRqgW7iSMIl4kjCJc\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606953247019008879324.jpeg/5y0zPdFTOgtfG17-AhLN9XInShLYz3vuyVgNislYDYo\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606951288147968361254.jpeg/0-8JfqjWdoXmrCiqI-9JfUslQ90fBS0PmypCc5sqQnM\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606960151236608802573.jpeg/Z9IHkoHC2E6GYMYLCl_4Xgv3oeMRjzooGTZKvRk2Sr0\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure><figure><img alt=\"特朗普Donald Trump（GettyImages）\" src=\"https://cdn.hk01.com/di/media/images/dw/20260110/1086606960327397376528193.jpeg/Ri7kepvNGAYlVURXLmdLzevcVStnMtixTnKTQk5yk0I\"/><figcaption>特朗普Donald Trump（GettyImages）</figcaption></figure></body></html>","scraped_at":"2026-09-08T06:04:07.210943+00:00","quality":{"score":3,"chars":2008,"images":27,"source":"HK01 中國","fallback":"none"}}