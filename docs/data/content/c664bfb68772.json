12T11:19:07.847753+00:00","quality":{"score":3,"chars":2696,"images":31,"source":"HK01 熱話","fallback":"none"},"published_at":"2026-10-12T11:00:24+00:00","fetched_at":"2026-10-12T14:57:52.396667+00:00","content_updated_at":"2026-10-12T11:17:37.444729+00:00","content_hash":"e96d4980d229bbf5e8c45cc956bbd6dac883157c8668f5b8007971299d883e6c","evidence_status":"full","scrape_error":null,"content_retention":null}