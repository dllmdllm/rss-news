{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組一般選舉投票期間，多名官員到各個票站了解運作情況。<br/>\n<br/>\n選舉管理委員會主席陸啟康表示，有信心今天能夠在合理時間內完成點票和宣布結果。<br/>\n<br/>\n<br/>\n<br/>\n編輯：汪溟曦\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T11:24:01.407640+00:00","quality":{"score":0,"chars":80,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T10:51:18+00:00","fetched_at":"2026-11-22T13:17:28.664061+00:00","content_updated_at":"2026-11-22T11:17:24.563931+00:00","content_hash":"278c533ec615742ec54b9b8f7ac3bbe6e6266898f8b21c4d14ba4d62f22ced97","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}