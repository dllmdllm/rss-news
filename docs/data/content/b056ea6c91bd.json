{"version":1,"content":"<html>\n<body><p>\n\t\t\t屯門建發里2號一幢工業大廈有棚網起火，暫時無人受傷。<br/>\n<br/>\n火警發生在下午約2時。消防列作一級火，派出一條喉及一隊煙帽隊到場灌救。<br/>\n<br/>\n<br/>\n<br/>\n編輯：陳樂謙\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-28T07:15:08.939268+00:00","quality":{"score":0,"chars":69,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-28T06:41:47+00:00","fetched_at":"2026-11-28T07:08:46.296445+00:00","content_updated_at":"2026-11-28T07:08:46.296445+00:00","content_hash":"e41f00f7da2ddf52d75791882f6e241565d0ba4d85746ac7d8010efed89d9b10","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}