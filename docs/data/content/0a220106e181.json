{"version":1,"content":"<html>\n<body><p>\n\t\t\t國家主席習近平今日上午在深圳，分別會見來華出席亞太經合組織領導人非正式會議的澳洲總理阿爾巴內塞，以及印尼總統普拉博沃。<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n編輯：羅宇光\t\t</p>\n<ul><li>主頁</li></ul></body>\n</html>","scraped_at":"2026-11-20T02:43:53.572184+00:00","quality":{"score":0,"chars":69,"images":0,"source":"RTHK 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-20T02:20:48+00:00","fetched_at":"2026-11-20T11:57:37.519598+00:00","content_updated_at":"2026-11-20T02:37:27.065099+00:00","content_hash":"7da286a7deb96f31615c8e584a9d150b4b3818e95786978843fa6fd19d59260e","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}