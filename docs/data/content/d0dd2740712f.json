ity":{"score":3,"chars":1723,"images":6,"source":"HK01 國際","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-14T02:27:36+00:00","fetched_at":"2026-11-14T06:54:44.713528+00:00","content_updated_at":"2026-11-14T02:51:49.666220+00:00","content_hash":"d7ee761073527ff756be78b80f8588f3345ef2cc9cf88c32b11302ac359b097f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}