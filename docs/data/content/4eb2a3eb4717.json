{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t美國聯儲局一如預期維持利率不變，滙豐銀行及中銀香港都宣布維持港元最優惠利率在目前5厘水平。<br/>\n<br/>\r\n兩家銀行的港元儲蓄存款利率亦維持不變。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：宋家樑\t\t</p>\n</body>\n</html>","scraped_at":"2026-10-29T05:21:12.961147+00:00","quality":{"score":0,"chars":72,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-29T04:57:47+00:00","fetched_at":"2026-10-29T05:18:35.972028+00:00","content_updated_at":"2026-10-29T05:18:35.972028+00:00","content_hash":"a3ff702c2d85c25e40b42be7543320d3b45051937b4e1ba2b196c3d437f644ef","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}