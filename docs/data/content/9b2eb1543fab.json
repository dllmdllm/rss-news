rc=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/22358deaa5124bba95e73ab88b7b6f1d/2026-11/xiaoyeliuhua.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/ff7e1033794527a5285e78d13435d3e8/2026-11/qidaowu.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/a1669cb8f4ab751129f40c463cc30219/2026-11/qisenlili.jpg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/93c2db2c62c2832a39b3a4f51f988d4a/2026-11/minamo.jpg\"/>\n</body>\n</html>","scraped_at":"2026-11-11T14:59:54.624825+00:00","quality":{"score":2,"chars":734,"images":31,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-11T12:19:40+00:00","fetched_at":"2026-11-11T23:39:56.451914+00:00","content_updated_at":"2026-11-11T14:53:26.580914+00:00","content_hash":"ecefc1411559bf35c88abd5eef0ceedd998554ec184aa720b53c5dde47e78557","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}