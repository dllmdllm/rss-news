{"version":1,"content":"<html>\n<body><p>\n\t\t\t亞太經合組織領導人非正式會議在深圳舉行期間，特區政府與智利政府簽署工作假期計劃協議。<br/>\n<br/>\n勞工及福利局局長孫玉菡表示，預計明年上半年可以落實推行。<br/>\n<br/>\n<br/>\n<br/>\n編輯：汪溟曦\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T11:24:01.405564+00:00","quality":{"score":0,"chars":78,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T10:54:32+00:00","fetched_at":"2026-11-22T11:57:26.034096+00:00","content_updated_at":"2026-11-22T11:17:24.788320+00:00","content_hash":"8e327bb698c02237fcfa2855ee631cb0f000d04beb8588a205d793680b81a812","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}