{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t政府預計，皇崗口岸在周末萬聖節期間，出境人流和車流在深宵時段最繁忙。<br/>\n<br/>\r\n政務司司長陳國基表示，會採取「公共交通優先」政策，呼籲旅客錯峰出行，又或者留在香港過夜。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：梁家奇\t\t</p>\n</body>\n</html>","scraped_at":"2026-10-28T12:01:19.144056+00:00","quality":{"score":0,"chars":86,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-28T11:43:35+00:00","fetched_at":"2026-10-28T20:18:40.120828+00:00","content_updated_at":"2026-10-28T11:58:40.682100+00:00","content_hash":"4924d9dafc86c8dc291294cf54fe27dd5c11d2c987d97b299b75c66e6f2328ac","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}