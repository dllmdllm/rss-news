n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/ur/sthl/8a14feb49042985565afe46295d06696/2026-08/WhatsApp_Image_2026-08-27_at_16_40_14.jpeg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/ur/sthl/5c79b486e1e9127ae0bb818fd4352130/2026-08/WhatsApp_Image_2026-08-27_at_16_40_16.jpeg\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/ur/sthl/b8c310e2ae473d323655340ea00df742/2026-08/WhatsApp_Image_2026-08-27_at_16_41_33.jpeg\"/>\n<p>陳嘉甜</p>\n</body>\n</html>","scraped_at":"2026-08-27T09:59:51.388764+00:00","quality":{"score":1,"chars":315,"images":28,"source":"星島頭條","fallback":"none"}}