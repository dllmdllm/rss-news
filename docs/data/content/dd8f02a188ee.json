mage.hkhl.hk/f/1024p0/0x0/100/none/906a6523234538d7e492ed2459c96c02/2026-11/BIGBANG_77_.jpeg\"/>\n<img alt=\"GD\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/56f06c1d294f41e1a696a2cd69ce368d/2026-11/BIGBANG_78_.jpeg\"/>\n<img alt=\"GD\" src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/aa6d224c535c35db48196eb50a494355/2026-11/BIGBANG_79_.jpeg\"/>\n</body>\n</html>","scraped_at":"2026-11-13T13:21:56.855031+00:00","quality":{"score":2,"chars":681,"images":72,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-13T12:48:36+00:00","fetched_at":"2026-11-13T13:15:27.867912+00:00","content_updated_at":"2026-11-13T13:15:27.867912+00:00","content_hash":"10987bdad2858f94e8d4de89f96196d1ab04d4a62993d9f535a70d83d36a4a4d","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}