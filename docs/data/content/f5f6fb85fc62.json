0x0/100/none/aa9fa0cb6b0fe3198e58bc3b7ebaa724/2024-05/62_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/86216d31365171d9959b53249441deaf/2024-05/63_6.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/6ec9efa352bfdae840a8c7a1a0fc10c7/2024-05/64_6.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/c55747f64ddd4dff66385529859c3029/2024-05/65_6.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/9fcd7434d288dea18352a864b495506f/2024-05/66_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/281c8aedf8e03d799fe52645e6f26473/2024-05/67_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/ef0ddd048a17a88ce51db6e122d67674/2024-05/68_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/5a606eab76c439403750853bad71efb1/2024-05/69_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/de2d7096d8320b4e5d56c34e67a9bfcf/2024-05/70_5.png\"/>\n<img src=\"https://image.hkhl.hk/f/1024p0/0x0/100/none/e2b7b1ad2e95e9317a15071047b9124d/2024-05/71_5.png\"/>\n<p>---</p>\n<p></p>\n<p></p>\n<p></p>\n</body>\n</html>","scraped_at":"2026-11-24T12:24:02.173089+00:00","quality":{"score":3,"chars":1832,"images":62,"source":"星島頭條","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-24T12:00:51+00:00","fetched_at":"2026-11-24T22:17:53.346017+00:00","content_updated_at":"2026-11-24T12:17:28.448396+00:00","content_hash":"4fe5a3f4ddc3d70ec56aec820a77e276a5265a0bbec611851ec5797ee619496f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}