-11-27T22:24:16.315628+00:00","quality":{"score":2,"chars":881,"images":32,"source":"HK01 社會","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-27T22:01:31+00:00","fetched_at":"2026-11-28T04:34:47.201363+00:00","content_updated_at":"2026-11-27T22:17:44.549292+00:00","content_hash":"9b5e5fb81fa040d2d7e1dd72d6c8a9587a1e6bccb8ad9d1f00dcc2a8378dad42","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}