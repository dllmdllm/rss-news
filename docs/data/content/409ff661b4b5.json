6842091.jpeg/paUDeuAOP5SEOBQcJwjwNPuQPg_v4PTxvyU8E78lPBM\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790289253142528648153.jpeg/tqUK9lm3DMtX1_F4icHoiVF4t5nk4OkI8EL_5vBC_-Y\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790290176020480478356.jpeg/R-7VIUR3QspAW1S0isIQKLEyyMWowkLq86gNYfOoDWE\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790286996475904962587.jpeg/8LyIqiz3EmEiOJBKhB0UXBiEr54e77axJdSAKCXUgCg\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790286522650624842159.jpeg/PgNL2xzI36269h2KEkQyAugZwTpewnvxH8oIDh_KCA4\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790286136643584568390.jpeg/exW8AqLPduQwm9oji0Vki1Srd4du0OKi-ZI0dvmSNHY\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790283410214912302614.jpeg/aC4zXPpwh7B4DvoYHMcUuRAF9zi46yji-9qyIfvasiE\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790284945461248497058.jpeg/syiFLTxXBdDYyTtz6Bxapf_k-RWvcNRNNsy2fDbMtnw\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790284614111232231704.jpeg/SXfGKdGfOvwOj9jfVSsWRajltCaCA5w2OasU4zmrFOM\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790284983078912017348.jpeg/OFfec3jwl6QDbR832s0WaoamRyXf9hzN2ssNV9rLDVc\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790286996606976406259.jpeg/kiwFZLZoODnACRTGUEAuqWbg5O3mmMoOzmoEjM5qBIw\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790282508439552374602.jpeg/FkNS9Y8-doF6Hpg63LtlRdkb2doJ9h62iN1F8ojdRfI\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790280650231808162387.jpeg/3BYZDK0P0xtAwaHajOcxnAX17b5cFNcyZc9MVGXPTFQ\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790278641029120759124.jpeg/hjUFfY1MXOlCXPloT9QRhz9iNaPVRjAXTeMVHE3jFRw\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790279022710784241578.jpeg/AYtQUBFJV_SV5XXUOzOgH2ByUT7iTbK0hFGWi4RRlos\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><figure><img alt=\"陳語謙  （IG@cyc.85）\" src=\"https://cdn.hk01.com/di/media/images/dw/20210602/476790280968998912978453.jpeg/yTz-YjQYsqgNun-PaP_3FCinOzWVP0jZfDjp53w46ec\"/><figcaption>陳語謙  （IG@cyc.85）</figcaption></figure><p>陳語謙堅強抗癌　坦言：也會偷哭一下</p><p>陳語謙表示，生病後發現自己的優點，就是很樂觀，印象中從確診到目前哭過5次，但她不會讓自己哭太久，因為哭完睡覺會鼻塞，隔天又會眼睛腫，怕家人看到會擔心。</p><p>不過，陳語謙坦言，自己還是會難過、害怕，依然會偷哭一下。她分享最近一次情緒潰堤就在上週五，兒子突然發燒，不停哭喊媽媽，想和她一起睡覺，但偏偏自己全身過敏、又熱又癢，臉部甚至頭皮都發紅，且進行完化療這段期間白血球較低，家人也不敢讓孩子太靠近。</p><p>不捨兒哭喊媽媽　陳語謙淚崩：無能為力</p><p>「但看著他一直喊媽媽，好捨不得…還是把他抱在懷裡哄睡了」，陳語謙頓時百感交集，看著懷中睡著的兒子，她表示突然覺得很難過，很想好好照顧、陪伴身邊的人，卻發現有時候卻連這麼簡單的事情，都變得無能為力。「原來生病最難過的時候，不一定是自己身體不舒服，而是想照顧愛的人，卻發現自己也需要被照顧」。最後，她也提到，真的很感謝身邊的家人們。</p><figure><img alt=\"【延伸閱讀：美女網紅一隻阿圓與陳百祥兩年情玩完　IG發文：結束了】一隻阿圓（IG@nanaciaociao）\" src=\"https://cdn.hk01.com/di/media/images/dw/20230628/750682008644096000860125.jpeg/