m/di/media/images/dw/20260527/1136372225440485376248597.jpeg/jMB_7nUEOF2m-Ejm5kQn9qwVLOFWvV9MzQgPHtgIDx4\"/><figcaption>(梁鵬威攝)</figcaption></figure></body></html>","scraped_at":"2026-10-11T22:37:55.543196+00:00","quality":{"score":2,"chars":1043,"images":35,"source":"HK01 社會","fallback":"none"}}