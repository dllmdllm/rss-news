"https://cdn.hk01.com/di/media/images/dw/20261025/1191035065874780160801963.png/CSAkLr73hhuAe5mslZ8OvKganSh7r9jDXcHY4V3B2OE\"/><figcaption>《玉簟秋》最新大結局日曆！（微博@電視劇玉簟秋）</figcaption></figure><figure><img alt=\"《玉簟秋》最新大結局日曆！（微博@電視劇玉簟秋）\" src=\"https://cdn.hk01.com/di/media/images/dw/20261025/1191035068450213888507129.png/YfnlNsSs3QKd26mDYTH-KyEKT53mxTApPhA-aj4QPmo\"/><figcaption>《玉簟秋》最新大結局日曆！（微博@電視劇玉簟秋）</figcaption></figure></body></html>","scraped_at":"2026-10-25T08:44:00.919589+00:00","quality":{"score":3,"chars":1573,"images":22,"source":"HK01 娛樂","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-25T08:30:32+00:00","fetched_at":"2026-10-25T08:58:18.077208+00:00","content_updated_at":"2026-10-25T08:40:53.291904+00:00","content_hash":"ca3bc154238d0497ac4d3ceec3ac80fc177938c85463674b6574b3c2a61a36f6","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}