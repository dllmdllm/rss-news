{"version":1,"content":"<html>\n<body><p>\r\n\t\t\t大埔宏福苑火災獨立委員會日前向行政長官提交報告，保安局局長鄧炳強表示，當局特別針對特大火災，或火警裝置等問題推出新措施，又會推出連串法例改革。<br/>\n<br/>\n<br/>\n<br/>\r\n編輯：詹可揚\t\t</p>\n</body>\n</html>","scraped_at":"2026-10-23T13:04:42.749124+00:00","quality":{"score":0,"chars":78,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-10-23T11:34:10+00:00","fetched_at":"2026-10-24T04:18:39.531289+00:00","content_updated_at":"2026-10-23T12:58:33.456210+00:00","content_hash":"4d67b6e2e4caba3dbb1b72890438943ea9aec6b16710ec2fa0e12c2c7ec26912","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}