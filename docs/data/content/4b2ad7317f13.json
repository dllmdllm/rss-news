{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，科技創新界15名當選人分別是張梓昌、徐海山、楊夢甦、鄭振華、林曉鋒、錢國強、沈向洋、黃秉修、李帆風、馬惟善、涂文偉、黃建恒、鄭松岩、馬桂宜、李煥明。<br/>\n<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T13:23:52.145587+00:00","quality":{"score":0,"chars":99,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T13:02:18+00:00","fetched_at":"2026-11-22T14:17:24.899020+00:00","content_updated_at":"2026-11-22T13:17:26.670805+00:00","content_hash":"84207cc5603f47fed417967e35473f9bb8205b406968af3fd74eb2f1d9fdef81","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}