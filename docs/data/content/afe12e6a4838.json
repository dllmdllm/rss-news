{"version":1,"content":"<html>\n<body><p>\n\t\t\t選舉委員會界別分組選舉結果陸續公布，批發及零售界17名當選人分別是黃立愷、林偉文、黃紹基、李勝幟、潘偉駿、余偉傑、謝邱安儀、梁勵、郭詩慧、林文華、李致慧、葉本良、吳永恩、張志祥、孫道弘、陳錦榮、蘇啟國。<br/>\n<br/>\n<br/>\n編輯：黃佩珊\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-22T14:43:50.677573+00:00","quality":{"score":0,"chars":108,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-22T14:17:23+00:00","fetched_at":"2026-11-22T17:37:48.144380+00:00","content_updated_at":"2026-11-22T14:37:27.917062+00:00","content_hash":"f9cce771c45d5fc92d99a47cadc84507307d8a6b0deb47c5f95174394b8e131d","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}