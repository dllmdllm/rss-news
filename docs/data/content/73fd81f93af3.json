{"version":1,"content":"<html>\n<body><p>\n\t\t\t聖公會基孝中學有學生被外置充電器燒傷。<br/>\n<br/>\n警方3時許接報，指啟田道5號聖公會基孝中學有外置充電器起火，一名男學生手部受傷，送往聯合醫院治理。<br/>\n<br/>\n<br/>\n編輯：鍾慧儀\t\t</p>\n</body>\n</html>","scraped_at":"2026-11-19T10:15:37.935891+00:00","quality":{"score":0,"chars":76,"images":0,"source":"RTHK 本地","fallback":"none","origin":"article-html","completeness":"extracted"},"published_at":"2026-11-19T09:56:53+00:00","fetched_at":"2026-11-19T20:16:57.945052+00:00","content_updated_at":"2026-11-19T10:09:02.963421+00:00","content_hash":"fdefaec79e503c081fc5eb412778911fb97f3524b50ace0b8c43e9053e32339f","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}