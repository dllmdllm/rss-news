03+00:00","fetched_at":"2026-11-16T23:15:06.478297+00:00","content_updated_at":"2026-11-16T22:17:44.657729+00:00","content_hash":"cfecb06285d1d7ecdca75bf0b31287fb2aa816678de85a2061a25f9ec84c4198","evidence_status":"full","scrape_error":null,"content_retention":null,"content_capture":null}